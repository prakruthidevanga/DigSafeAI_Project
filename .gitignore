# ─── Environment / secrets ───────────────────────────────────────────────────
# Never commit real .env files. Use .env.example as the template.
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env

# ─── Logs ────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─── Local model artifacts ───────────────────────────────────────────────────
# Keep model artifacts tracked for production deployment
!backend/ml/models/*.joblib
!backend/ml/vision/faster_rcnn/*.part*
backend/ml/vision/faster_rcnn/faster_rcnn_model (1).pth.zip
backend/ml/vision/detr/dataset2_detr_model (1).zip


# ─── Large dataset files ─────────────────────────────────────────────────────
# KML and CSV datasets are imported via `node scripts/importDatasets.js`.
# Do not commit them to git; distribute via a separate data channel.
Datasets/

