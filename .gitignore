.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
.idea/
.vscode/settings.json
*.orig

# ─── Test / coverage output ──────────────────────────────────────────────────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/

# ─── Temporary files ─────────────────────────────────────────────────────────
tmp/
temp/
*.tmp
